integrator              = md
dt                      = 0.002
nsteps                  = 10000000
nstlog                  = 10000
nstenergy               = 5000
nstxout-compressed      = 10000
compressed-x-grps       = Prot_Lig
continuation            = yes
gen_vel                 = no
constraints             = h-bonds
constraint_algorithm    = lincs
cutoff-scheme           = Verlet
coulombtype             = PME
rcoulomb                = 1.0
rvdw                    = 1.0
fourierspacing          = 0.12
DispCorr                = EnerPres
tcoupl                  = V-rescale
tc-grps                 = System
tau_t                   = 0.1
ref_t                   = 300
pcoupl                  = C-rescale
pcoupltype              = isotropic
tau_p                   = 2.0
ref_p                   = 1.0
compressibility         = 4.5e-5
pbc                     = xyz
