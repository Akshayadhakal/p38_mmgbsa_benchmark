define                  = -DPOSRES
integrator              = md
dt                      = 0.002
nsteps                  = 50000        ; 100 ps
nstlog                  = 1000
nstenergy               = 1000
nstxout-compressed      = 5000
continuation            = no
gen_vel                 = yes
gen_temp                = 300
gen_seed                = -1
constraints             = h-bonds
constraint_algorithm    = lincs
cutoff-scheme           = Verlet
coulombtype             = PME
rcoulomb                = 1.0
rvdw                    = 1.0
fourierspacing          = 0.12
DispCorr                = EnerPres
tcoupl                  = V-rescale
tc-grps                 = System
tau_t                   = 0.1
ref_t                   = 300
pcoupl                  = no
pbc                     = xyz
